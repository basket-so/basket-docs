---
// A basket at a glance, with as few words as possible: USDC flows in to mint, the ring shows
// what one basket token holds (its tokens and their shares), and on redeem the share flows back
// out as USDC. Uses SOLB's components at their starting weights, for a token worth $1.00.
import data from '../../data/baskets.json';

const ramp = ['#3f6b4f', '#5f8a68', '#86a37f', '#b3a37f', '#d29a6e', '#b8754a'];
const basket = data.baskets.find((b) => b.symbol === 'SOLB') ?? data.baskets[0];
const components = basket.components.slice(0, 6);
const total = components.reduce((sum, c) => sum + (c.weightBps ?? 0), 0) || 1;

// Ring segments in percent of the circle (pathLength 100), with a small gap after each.
const GAP = 0.9;
let start = 0;
const segments = components.map((c, i) => {
	const pct = ((c.weightBps ?? 0) / total) * 100;
	const segment = { symbol: c.symbol, c: ramp[i], pct, start, len: Math.max(pct - GAP, 0.6) };
	start += pct;
	return segment;
});
const pctLabel = (pct: number) => `${Math.round(pct)}%`;

// Each segment draws in its own window of the loop (percent of --t), and its legend entry
// appears with it.
const firstSegment = 30;
const segmentGap = 4.5;
const segmentCss = segments
	.map((s, i) => {
		const from = firstSegment + i * segmentGap;
		const to = from + segmentGap + 1;
		return `.bc .bc-seg-${i} { animation: bc-seg-${i} var(--t) infinite both; }
.bc .bc-key-${i} { animation: bc-key-${i} var(--t) infinite both; }
@keyframes bc-seg-${i} { 0%, ${from}% { stroke-dasharray: 0 100; } ${to}%, 100% { stroke-dasharray: ${s.len.toFixed(2)} 100; } }
@keyframes bc-key-${i} { 0%, ${from}% { opacity: 0.25; } ${from + 2}%, 100% { opacity: 1; } }`;
	})
	.join('\n');
const css = `@media (prefers-reduced-motion: no-preference) {
${segmentCss}
}`;
---

<figure class="viz not-content bc">
	<div class="viz-loop" aria-hidden="true">
		<div class="bc-stage">
			<div class="bc-side bc-in">
				<span class="viz-kicker">Mint</span>
				<span class="bc-cash">USDC</span>
			</div>
			<div class="bc-lane bc-lane-in">
				{segments.slice(0, 3).map((s, i) => <b style={`--c:${s.c};--d:${(i * 0.025).toFixed(3)}`} />)}
			</div>
			<div class="bc-ring">
				<svg viewBox="0 0 200 200" role="presentation">
					<circle class="bc-track" cx="100" cy="100" r="78" pathLength="100" />
					{segments.map((s, i) => (
						<circle
							class={`bc-seg bc-seg-${i}`}
							cx="100"
							cy="100"
							r="78"
							pathLength="100"
							stroke={s.c}
							stroke-dasharray={`${s.len.toFixed(2)} 100`}
							stroke-dashoffset={(-s.start).toFixed(2)}
							transform="rotate(-90 100 100)"
						/>
					))}
				</svg>
				<div class="bc-center">
					<span class="bc-center-token">1 {basket.symbol}</span>
					<span class="bc-center-value">$1.00</span>
				</div>
			</div>
			<div class="bc-lane bc-lane-out">
				{segments.slice(0, 3).map((s, i) => <b style={`--c:${s.c};--d:${(i * 0.025).toFixed(3)}`} />)}
			</div>
			<div class="bc-side bc-out">
				<span class="viz-kicker">Redeem</span>
				<span class="bc-cash">USDC</span>
			</div>
		</div>
		<ul class="bc-legend">
			{segments.map((s, i) => (
				<li class={`bc-key-${i}`}>
					<i style={`background:${s.c}`} />
					<b>{s.symbol}</b>
					<span>{pctLabel(s.pct)}</span>
				</li>
			))}
		</ul>
	</div>
</figure>

<style is:inline set:html={css}></style>

<style>
	.bc {
		--t: 13s;
	}
	.bc-stage {
		display: grid;
		grid-template-columns: auto minmax(2.5rem, 1fr) auto minmax(2.5rem, 1fr) auto;
		align-items: center;
	}
	.bc-side {
		display: grid;
		justify-items: center;
		gap: 0.4rem;
	}
	.bc-cash {
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--viz-usdc);
		border-radius: 999px;
		background: var(--viz-usdc-soft);
		color: #2f4a69;
		font-weight: 600;
		white-space: nowrap;
	}

	/* Lanes: dots carry USDC into the ring (turning into its tokens) and back out. */
	.bc-lane {
		position: relative;
		height: 2px;
		margin: 0 0.6rem;
		background: repeating-linear-gradient(90deg, var(--viz-line) 0 4px, transparent 4px 8px);
	}
	.bc-lane b {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.6rem;
		height: 0.6rem;
		margin: -0.3rem 0 0 -0.3rem;
		border-radius: 50%;
		opacity: 0;
	}

	/* The ring: one segment per token, sized by its share of the basket token's value. */
	.bc-ring {
		position: relative;
		width: 13rem;
		aspect-ratio: 1;
	}
	.bc-ring svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.bc-track,
	.bc-seg {
		fill: none;
		stroke-width: 24;
	}
	.bc-track {
		stroke: var(--viz-line-soft);
	}
	.bc-center {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 0.1rem;
		text-align: center;
	}
	.bc-center-token {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--viz-copper);
	}
	.bc-center-value {
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.bc-legend {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 7rem));
		justify-content: center;
		gap: 0.5rem 1.5rem;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.bc-legend li {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
	}
	.bc-legend i {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 3px;
		flex-shrink: 0;
	}
	.bc-legend b {
		font-weight: 600;
	}
	.bc-legend span {
		margin-left: auto;
		color: var(--viz-muted);
		font-variant-numeric: tabular-nums;
	}

	/* Phones: the ring on top, mint and redeem side by side under it. */
	@media (max-width: 34rem) {
		.bc-stage {
			grid-template-columns: 1fr 1fr;
			row-gap: 0.9rem;
		}
		.bc-ring {
			grid-column: 1 / -1;
			grid-row: 1;
			justify-self: center;
			width: 11rem;
		}
		.bc-in {
			grid-row: 2;
			grid-column: 1;
		}
		.bc-out {
			grid-row: 2;
			grid-column: 2;
		}
		.bc-lane {
			display: none;
		}
		.bc-legend {
			grid-template-columns: repeat(2, minmax(0, 7rem));
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.bc-in .bc-cash {
			animation: bc-in-glow var(--t) infinite both;
		}
		.bc-out .bc-cash {
			animation: bc-out-glow var(--t) infinite both;
		}
		.bc-lane-in b {
			animation: bc-dot-in var(--t) linear infinite both;
			animation-delay: calc(var(--d) * var(--t));
		}
		.bc-lane-out b {
			animation: bc-dot-out var(--t) linear infinite both;
			animation-delay: calc(var(--d) * var(--t));
		}
		.bc-center {
			animation: bc-center var(--t) infinite both;
		}
	}

	/* Mint 0-30%, the ring fills 30-58%, redeem 64-97%. */
	@keyframes bc-in-glow {
		0%, 4% { box-shadow: 0 0 0 0 transparent; }
		8%, 24% { box-shadow: 0 0 0 4px var(--viz-usdc-soft); }
		30%, 100% { box-shadow: 0 0 0 0 transparent; }
	}
	@keyframes bc-out-glow {
		0%, 76% { box-shadow: 0 0 0 0 transparent; }
		80%, 92% { box-shadow: 0 0 0 4px var(--viz-usdc-soft); }
		97%, 100% { box-shadow: 0 0 0 0 transparent; }
	}
	/* In: leaves as USDC, arrives as one of the basket's tokens. */
	@keyframes bc-dot-in {
		0%, 7% { left: 0; opacity: 0; background: var(--viz-usdc); }
		8% { left: 0; opacity: 1; background: var(--viz-usdc); }
		15% { background: var(--viz-usdc); }
		19% { background: var(--c); }
		24% { left: 100%; opacity: 1; background: var(--c); }
		26%, 100% { left: 100%; opacity: 0; background: var(--c); }
	}
	/* Out: leaves as a token, arrives as USDC. */
	@keyframes bc-dot-out {
		0%, 65% { left: 0; opacity: 0; background: var(--c); }
		66% { left: 0; opacity: 1; background: var(--c); }
		72% { background: var(--c); }
		76% { background: var(--viz-usdc); }
		81% { left: 100%; opacity: 1; background: var(--viz-usdc); }
		83%, 100% { left: 100%; opacity: 0; background: var(--viz-usdc); }
	}
	@keyframes bc-center {
		0%, 50% { opacity: 0; transform: scale(0.9); }
		56%, 100% { opacity: 1; transform: none; }
	}
</style>
