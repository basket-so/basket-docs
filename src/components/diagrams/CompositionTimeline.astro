---
// A composition change from proposal to rebalance: three days' notice, a seven-day window
// to apply it, then a rebalance into the new weights. Tokens A-D are a made-up example.
const tokens = [
	{ symbol: 'A', c: '#3f6b4f', from: 50, to: 40 },
	{ symbol: 'B', c: '#86a37f', from: 30, to: 30 },
	{ symbol: 'C', c: '#d29a6e', from: 20, to: 15 },
	{ symbol: 'D', c: '#8e6a52', from: 0, to: 15 },
];
const rows = [
	{ key: 'prop', label: 'Proposed', a: 'to', b: 'to' },
	{ key: 'target', label: 'Targets', a: 'from', b: 'to' },
	{ key: 'hold', label: 'Holdings', a: 'from', b: 'to' },
] as const;
---

<figure class="viz not-content cc">
	<div class="viz-loop" aria-hidden="true">
		<div class="cc-bars">
			{rows.map((row) => (
				<div class={`cc-row cc-${row.key}`}>
					<span class="cc-label">{row.label}</span>
					<span class="cc-bar">
						{tokens.map((t) => (
							<span style={`--c:${t.c};--a:${t[row.a]};--b:${t[row.b]}`}>
								<em>{t.symbol}</em>
							</span>
						))}
					</span>
				</div>
			))}
		</div>

		<div class="cc-time">
			<div class="cc-zones">
				<span class="cc-notice"><span class="cc-long">Notice: 3 days</span><span class="cc-short">Notice</span></span>
				<span class="cc-window"><span class="cc-long">Apply window: 7 days</span><span class="cc-short">Apply window</span></span>
				<span class="cc-lapse">Lapses</span>
			</div>
			<div class="cc-track">
				<span class="cc-flag" style="left:0%">Proposed</span>
				<span class="cc-flag cc-applied" style="left:37.5%">Applied</span>
				<span class="cc-cursor"></span>
			</div>
			<div class="cc-scale">
				<span style="left:0%">Day 0</span>
				<span style="left:25%">3</span>
				<span style="left:83.333%">10</span>
			</div>
		</div>
	</div>
	<ul class="viz-says">
		<li data-s="1"><b>Day 0.</b> The authority proposes new weights: trim A and C, add a new token D. The app shows the change on the basket's page.</li>
		<li data-s="2"><b>Notice.</b> For three days nothing changes. Holders who don't want the new mix can redeem.</li>
		<li data-s="3"><b>Applied.</b> Within the next seven days the change is applied and the targets switch. D starts empty.</li>
		<li data-s="4"><b>Rebalance.</b> The keeper trades the holdings into the new weights.</li>
	</ul>
</figure>

<style>
	.cc {
		--t: 14s;
	}
	.cc-bars {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
	}
	.cc-row {
		display: grid;
		grid-template-columns: 4.6rem 1fr;
		align-items: center;
		gap: 0.6rem;
	}
	.cc-label {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--viz-ink-2);
	}
	.cc-bar {
		display: flex;
		gap: 2px;
		height: 1.35rem;
		border-radius: 3px;
		overflow: hidden;
	}
	.cc-bar > span {
		display: grid;
		place-items: center;
		flex: var(--b) 1 0;
		min-width: 0;
		background: var(--c);
		overflow: hidden;
	}
	.cc-bar em {
		font-style: normal;
		font-size: 0.66rem;
		font-weight: 600;
		color: #fff;
	}
	.cc-prop .cc-bar > span {
		background: color-mix(in srgb, var(--c) 30%, var(--viz-card));
		box-shadow: inset 0 0 0 1px var(--c);
	}
	.cc-prop .cc-bar em {
		color: var(--viz-ink);
	}

	.cc-zones {
		display: flex;
		gap: 2px;
		height: 1.4rem;
		font-size: 0.68rem;
		font-weight: 600;
	}
	.cc-zones > span {
		display: flex;
		align-items: center;
		padding: 0 0.4rem;
		border-radius: 3px;
		white-space: nowrap;
		overflow: hidden;
	}
	/* Days 0-12 across the track: notice 0-3, window 3-10, lapsed after. */
	.cc-notice {
		width: 25%;
		background: var(--viz-copper-soft);
		color: var(--viz-copper);
	}
	.cc-window {
		width: 58.333%;
		background: var(--viz-green-soft);
		color: var(--viz-green);
	}
	.cc-lapse {
		flex: 1;
		background: repeating-linear-gradient(135deg, var(--viz-line-soft) 0 4px, transparent 4px 8px);
		color: var(--viz-muted);
	}
	.cc-short {
		display: none;
	}
	.cc-track {
		position: relative;
		height: 1.6rem;
		border-bottom: 2px solid var(--viz-line);
	}
	.cc-flag {
		position: absolute;
		bottom: 0.25rem;
		font-size: 0.7rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.cc-applied {
		color: var(--viz-green);
		transform: translateX(-50%);
	}
	.cc-cursor {
		position: absolute;
		left: 37.5%;
		bottom: -0.45rem;
		width: 0.8rem;
		height: 0.8rem;
		margin-left: -0.4rem;
		border-radius: 50%;
		background: var(--viz-ink);
		border: 2px solid var(--viz-paper);
	}
	.cc-scale {
		position: relative;
		height: 1.1rem;
		margin-top: 0.5rem;
		font-size: 0.68rem;
		color: var(--viz-muted);
	}
	.cc-scale span {
		position: absolute;
		white-space: nowrap;
	}
	.cc-scale span + span {
		transform: translateX(-50%);
	}
	@media (max-width: 30rem) {
		.cc-row {
			grid-template-columns: 3.9rem 1fr;
		}
		.cc-long {
			display: none;
		}
		.cc-short {
			display: inline;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		[data-s='1'] { animation: cc-s1 var(--t) infinite both; }
		[data-s='2'] { animation: cc-s2 var(--t) infinite both; }
		[data-s='3'] { animation: cc-s3 var(--t) infinite both; }
		[data-s='4'] { animation: cc-s4 var(--t) infinite both; }

		.cc-prop {
			animation: cc-prop var(--t) infinite both;
		}
		.cc-target .cc-bar > span {
			animation: cc-target var(--t) infinite both;
		}
		.cc-hold .cc-bar > span {
			animation: cc-hold var(--t) infinite both;
		}
		.cc-cursor {
			animation: cc-cursor var(--t) infinite both;
		}
		.cc-applied {
			animation: cc-applied var(--t) infinite both;
		}
	}

	@keyframes cc-s1 {
		0% { --viz-on: 0; }
		2%, 12% { --viz-on: 1; }
		14%, 100% { --viz-on: 0; }
	}
	@keyframes cc-s2 {
		0%, 12% { --viz-on: 0; }
		14%, 42% { --viz-on: 1; }
		44%, 100% { --viz-on: 0; }
	}
	@keyframes cc-s3 {
		0%, 42% { --viz-on: 0; }
		44%, 62% { --viz-on: 1; }
		64%, 100% { --viz-on: 0; }
	}
	@keyframes cc-s4 {
		0%, 62% { --viz-on: 0; }
		64%, 97% { --viz-on: 1; }
		100% { --viz-on: 0; }
	}
	@keyframes cc-prop {
		0%, 3% { opacity: 0; transform: translateY(-0.2rem); }
		7%, 100% { opacity: 1; transform: none; }
	}
	/* Segment widths go from --a (before) to --b (after). */
	@keyframes cc-target {
		0%, 50% { flex-grow: var(--a); }
		56%, 100% { flex-grow: var(--b); }
	}
	@keyframes cc-hold {
		0%, 64% { flex-grow: var(--a); }
		78%, 100% { flex-grow: var(--b); }
	}
	/* Day d sits at d / 12 of the track. Applied on day 4.5. */
	@keyframes cc-cursor {
		0%, 6% { left: 0%; }
		42% { left: 25%; }
		50%, 100% { left: 37.5%; }
	}
	@keyframes cc-applied {
		0%, 49% { opacity: 0; }
		52%, 100% { opacity: 1; }
	}
</style>
